# ===========================================
# Server & Environment Configuration
# ===========================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ===========================================
# Database (MongoDB)
# ===========================================
# Docker internal: mongodb://admin:MySecret$$Password#2026@mongo:27017/global_fit_ulttra?authSource=admin
# Local: mongodb://localhost:27017/global_fit_ulttra
MONGODB_URI=mongodb://localhost:27017/global_fit_ulttra
MONGODB_POOL_SIZE=10
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=MySecret$$Password#2026

# ===========================================
# Redis (Caching & Distributed Rate Limiting)
# ===========================================
# Docker internal: redis://:8598y4u50y9@redis:6379
# Local: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=300

# ===========================================
# Message Queue (RabbitMQ)
# ===========================================
# Docker internal: amqp://globalfit_user:548t4u0u90@rabbitmq:5672
# Local: amqp://localhost:5672
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=global_fit_ulttra
RABBITMQ_DEFAULT_USER=globalfit_user
RABBITMQ_DEFAULT_PASS=

# ===========================================
# Security, CORS & Rate Limiting
# ===========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://backend-global-fit-ulttra.onrender.com
SOCKET_IO_CORS_ORIGIN=http://localhost:4000,http://localhost:5173,https://backend-global-fit-ulttra.onrender.com
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Circuit Breakers
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Feature Flags
ENABLE_CACHE_WARMING=false
ENABLE_METRICS_COLLECTION=true

# ===========================================
# Groq AI Services (LLM Inference)
# Get key from: https://console.groq.com/keys
# Key starts with "gsk_"
# ===========================================
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# AI Quota & Input Hardening
AI_DAILY_TOKEN_QUOTA=50000
AI_MAX_PROMPT_LENGTH=4000
AI_MAX_TOKENS=2048

# ===========================================
# Optional AI Gateway: LiteLLM
# Docker internal: http://litellm:4000/v1
# Local: http://localhost:4000/v1
# ===========================================
LITELLM_ENABLED=true
LITELLM_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-globalfit-master-key-2026
LITELLM_MASTER_KEY=sk-globalfit-master-key-2026

# ===========================================
# Agentic Hybrid Financial RAG Configuration
# ===========================================
VECTOR_STORE_PROVIDER=qdrant
# Docker internal: http://qdrant:6333
# Local: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=financial_chunks
QDRANT_TIMEOUT_MS=5000
RAG_REQUIRE_AUTH=true

# Embeddings
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
HUGGINGFACE_API_KEY=

# Hybrid Retrieval & Reciprocal Rank Fusion (RRF)
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_RRF_K=60
RAG_DENSE_WEIGHT=0.65
RAG_SPARSE_WEIGHT=0.35
RAG_MAX_ITERATIONS=3
RAG_MAX_RETRIEVAL_TIME_MS=12000

# Semantic Cache
RAG_SEMANTIC_CACHE_ENABLED=true

# Optional Tracing: LangSmith
LANGSMITH_ENABLED=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=global-fit-ulttra-rag
LANGCHAIN_PROJECT=global-fit-ulttra-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===========================================
# JWT Authentication (Min 32 characters for access & refresh secrets)
# ===========================================
JWT_SECRET=global-fit-ulttra-dev-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_ACCESS_SECRET=global-fit-ulttra-dev-access-secret-32-chars-minimum-required!
JWT_REFRESH_SECRET=global-fit-ulttra-dev-refresh-secret-32-chars-minimum-required!
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# External Financial Data API Keys (Optional)
# ===========================================
ALPHA_VANTAGE_API_KEY=demo
COINGECKO_API_KEY=
NEWS_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=

# ===========================================
# Keep-Alive Self-Ping
# ===========================================
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_URL=http://localhost:4000/api/v1/health/ping
KEEP_ALIVE_INTERVAL_MS=600000

# ===========================================
# Email Service (Resend)
# ===========================================
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Global_Fit_Ulttra <noreply@yourdomain.com>
FRONTEND_URL=http://localhost:5173

# ===========================================
# Multi-Factor Authentication (MFA / 2FA)
# ===========================================
MFA_ISSUER=GlobalFitUlttra

# ===========================================
# Stripe Payment & Billing Configuration
# ===========================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=