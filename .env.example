# ===========================================
# Global_Fit_Ulttra - ROOT Environment Template
# ===========================================
# This root .env.example documents variables read by:
#   1. docker-compose.yml       (LiteLLM gateway requires LITELLM_MASTER_KEY, LITELLM_SALT_KEY)
#   2. The backend application  (all other variables below)
#
# Copy this file to .env at the REPO ROOT for Docker Compose use.
# The backend application reads its .env from backend/.env (see backend/.env.example).

# ===========================================
# [REQUIRED by docker-compose.yml] LiteLLM Gateway Security
# ===========================================
# ONLY needed when running: docker-compose up litellm
# Generate secure random values with:
#   node -e "console.log('sk-' + require('crypto').randomBytes(16).toString('hex'))"
# WARNING: Keep LITELLM_SALT_KEY stable — changing it makes existing stored credentials unreadable.
LITELLM_MASTER_KEY=sk-your-litellm-master-key-here
LITELLM_SALT_KEY=sk-your-litellm-salt-key-here

# ===========================================
# [REQUIRED] Server Configuration
# ===========================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ===========================================
# [REQUIRED] Database (MongoDB)
# ===========================================
# Local:  mongodb://localhost:27017/global_fit_ulttra
# Atlas:  mongodb+srv://username:password@cluster.mongodb.net/global_fit_ulttra?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/global_fit_ulttra
MONGODB_POOL_SIZE=10

# ===========================================
# [OPTIONAL] Redis
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=300

# ===========================================
# [OPTIONAL] External Financial API Keys
# ===========================================
ALPHA_VANTAGE_API_KEY=demo
COINGECKO_API_KEY=
NEWS_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=

# ===========================================
# [REQUIRED] Security
# ===========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
JWT_SECRET=global-fit-ulttra-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# [OPTIONAL] Circuit Breaker
# ===========================================
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# ===========================================
# [OPTIONAL] Logging
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ===========================================
# [OPTIONAL] Socket.io
# ===========================================
SOCKET_IO_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ===========================================
# [OPTIONAL] Feature Flags & Keep-Alive
# ===========================================
ENABLE_CACHE_WARMING=false
ENABLE_METRICS_COLLECTION=true
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_URL=https://backend-global-fit-ulttra.onrender.com/api/v1/health/ping
KEEP_ALIVE_INTERVAL_MS=600000

# ===========================================
# [OPTIONAL] Message Queue (RabbitMQ)
# ===========================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=global_fit_ulttra

# ===========================================
# [CONDITIONAL] Groq AI Configuration
# ===========================================
# Also injected into the litellm container by docker-compose.yml
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ===========================================
# [CONDITIONAL] RAG - Qdrant Vector Database
# ===========================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=global_fit_ulttra_financial_documents
QDRANT_ENABLED=true

# ===========================================
# [CONDITIONAL] RAG - Embedding Engine
# ===========================================
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
COHERE_API_KEY=

# ===========================================
# [CONDITIONAL] RAG - Retrieval Parameters
# ===========================================
RAG_SEMANTIC_CACHE_ENABLED=true
RAG_SIMILARITY_THRESHOLD=0.65
RAG_RRF_DENSE_WEIGHT=0.65
RAG_RRF_SPARSE_WEIGHT=0.35
RAG_RRF_K=60
RAG_CONFIDENCE_THRESHOLD=0.40
RAG_MAX_AGENT_ITERATIONS=3

# ===========================================
# [CONDITIONAL] LiteLLM AI Gateway
# ===========================================
LITELLM_ENABLED=false
LITELLM_URL=http://localhost:8000/v1
LITELLM_API_KEY=

# ===========================================
# [CONDITIONAL] LangSmith Tracing
# ===========================================
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=global-fit-ulttra-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
