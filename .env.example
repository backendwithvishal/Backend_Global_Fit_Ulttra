NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (MongoDB)
MONGODB_URI=
MONGODB_POOL_SIZE=10
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD='MySecret$Password#2026'


# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=user932198
REDIS_TTL_DEFAULT=300

# Alpha Vantage - Stock quotes
# Get key at: https://www.alphavantage.co/support/#api-key/
ALPHA_VANTAGE_API_KEY=

# CoinGecko - Crypto prices (optional for free tier)
COINGECKO_API_KEY=CG-

# NewsAPI - Financial news
# Get key at: https://newsapi.org/register
NEWS_API_KEY=

# FRED - Economic indicators
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub - Market news
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://backend-global-fit-ulttra.onrender.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

SOCKET_IO_CORS_ORIGIN=http://localhost:4000,http://localhost:5173,https://backend-global-fit-ulttra.onrender.com

ENABLE_CACHE_WARMING=false
ENABLE_METRICS_COLLECTION=true

# Groq AI
GROQ_API_KEY=''
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Message Queue (RabbitMQ / CloudAMQP)
# Local: amqp://localhost:5672
# Cloud (CloudAMQP): amqps://username:password@host/vhost
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=global_fit_ulttra

# JWT Authentication
JWT_SECRET=global-fit-ulttra-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# Keep-Alive Self-Ping
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_URL=https://backend-global-fit-ulttra.onrender.com/api/v1/health/ping
KEEP_ALIVE_INTERVAL_MS=600000

# ===========================================
# Agentic Hybrid Financial RAG Configuration
# ===========================================
# Vector Store: qdrant (recommended) or mongodb (Atlas Vector Search fallback)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=financial_chunks
QDRANT_TIMEOUT_MS=5000

# Embedding Provider: local (Free, local Xenova/all-MiniLM-L6-v2, 384 dims) or huggingface
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
HUGGINGFACE_API_KEY=

# Hybrid Retrieval & Reciprocal Rank Fusion (RRF)
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_RRF_K=60
RAG_DENSE_WEIGHT=0.65
RAG_SPARSE_WEIGHT=0.35
RAG_MAX_ITERATIONS=3
RAG_MAX_RETRIEVAL_TIME_MS=12000

# Semantic Cache
RAG_SEMANTIC_CACHE_ENABLED=true

# Optional AI Gateway: LiteLLM (Self-hosted, 100% Free via Docker)
LITELLM_ENABLED=true
LITELLM_URL=http://localhost:8000/v1
LITELLM_API_KEY=

# Optional Tracing: LangSmith (Set false for zero cost)
LANGSMITH_ENABLED=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGSMITH_PROJECT=global-fit-ulttra-rag
LANGCHAIN_PROJECT=global-fit-ulttra-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# JWT Authentication
JWT_SECRET=global-fit-ulttra-dev-secret-change-in-production
JWT_EXPIRES_IN=7d
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=3d