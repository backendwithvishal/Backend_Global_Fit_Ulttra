# ==============================================================================
# Global_Fit_Ulttra - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env or backend/.env and configure for your environment.
# Generate cryptographic secrets using: openssl rand -base64 48
# NEVER commit real credentials to version control.
# ==============================================================================

# ===========================================
# [REQUIRED] Server Configuration
# ===========================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ===========================================
# [REQUIRED] Authentication & Security
# ===========================================
# Must be at least 32 characters long in production
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48_min_32_chars_access
JWT_REFRESH_SECRET=replace_with_openssl_rand_base64_48_min_32_chars_refresh
JWT_SECRET=replace_with_openssl_rand_base64_48_min_32_chars_access

# Token lifespans (short access token + refresh token rotation)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing cost (min 12 in production)
BCRYPT_ROUNDS=12

# Allowed web frontend origins (comma-separated, never '*' in production)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
SOCKET_IO_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# [REQUIRED] Database (MongoDB)
# ===========================================
MONGODB_URI=mongodb://localhost:27017/global_fit_ulttra
MONGODB_POOL_SIZE=10

# Docker Compose credentials (when using local containerized MongoDB)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=replace_with_strong_password_in_production

# ===========================================
# [OPTIONAL] Redis (Caching & Distributed Rate Limiting)
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=replace_with_strong_password_in_production
REDIS_TTL_DEFAULT=300

# ===========================================
# [OPTIONAL] Message Queue (RabbitMQ)
# ===========================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE_PREFIX=global_fit_ulttra
RABBITMQ_DEFAULT_USER=globalfit_user
RABBITMQ_DEFAULT_PASS=replace_with_strong_password_in_production

# ===========================================
# [OPTIONAL] AI Services (Groq Cloud)
# ===========================================
GROQ_API_KEY=gsk_placeholder_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# AI Quota & Input Hardening
AI_DAILY_TOKEN_QUOTA=50000
AI_MAX_PROMPT_LENGTH=4000
AI_MAX_TOKENS=4096

# ===========================================
# [OPTIONAL] Vector DB (Qdrant) & RAG Knowledge Base
# ===========================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace_with_qdrant_api_key_or_leave_blank_for_local
QDRANT_COLLECTION=global_fit_ulttra_financial_documents
QDRANT_ENABLED=true

# Embedding Provider: "local" (Xenova MiniLM, $0 cost) or "openai" / "huggingface"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# RAG Reranking & Ingestion
COHERE_API_KEY=
RAG_SEMANTIC_CACHE_ENABLED=true
RAG_SIMILARITY_THRESHOLD=0.65
RAG_RRF_DENSE_WEIGHT=0.65
RAG_RRF_SPARSE_WEIGHT=0.35
RAG_RRF_K=60
RAG_CONFIDENCE_THRESHOLD=0.40
RAG_MAX_AGENT_ITERATIONS=3
RAG_MAX_FILE_SIZE_BYTES=10485760

# ===========================================
# [OPTIONAL] External Financial Market APIs
# ===========================================
ALPHA_VANTAGE_API_KEY=demo
COINGECKO_API_KEY=
NEWS_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=

# ===========================================
# [OPTIONAL] Self-Hosted LiteLLM AI Gateway
# ===========================================
LITELLM_ENABLED=false
LITELLM_URL=http://localhost:8000/v1
LITELLM_MASTER_KEY=sk-replace-with-secure-litellm-master-key
LITELLM_API_KEY=

# ===========================================
# [OPTIONAL] Observability & System Resilience
# ===========================================
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=global-fit-ulttra-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_URL=http://localhost:4000/api/v1/health/ping
KEEP_ALIVE_INTERVAL_MS=600000
