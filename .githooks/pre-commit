#!/bin/sh
# Git pre-commit hook for automated secret leak prevention
# Global_Fit_Ulttra

export MSYS_NO_PATHCONV=1

if command -v gitleaks >/dev/null 2>&1; then
    echo "Running local gitleaks pre-commit check..."
    gitleaks protect --verbose --staged
    exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo "❌ Gitleaks detected potential secret leaks in staged files. Commit rejected."
        exit $exit_code
    fi
elif command -v docker >/dev/null 2>&1; then
    echo "Running gitleaks via Docker on staged files..."
    docker run --rm -v "$(pwd):/path" -w /path zricethezav/gitleaks:latest git --staged
    exit_code=$?
    if [ $exit_code -ne 0 ]; then
        echo "❌ Gitleaks detected potential secret leaks in staged files. Commit rejected."
        exit $exit_code
    fi
else
    echo "⚠️ Warning: Neither gitleaks nor docker found on PATH. Skipping pre-commit secret check."
fi
exit 0
