# ===========================================
# Global_Fit_Ulttra - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# All variables have sensible defaults for local development.
#
# [REQUIRED]    Application will NOT start without these.
# [CONDITIONAL] Required only when the associated feature is enabled.
# [OPTIONAL]    Safe default exists; can be omitted.

# ===========================================
# [REQUIRED] Server Configuration
# ===========================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ===========================================
# [REQUIRED] Database (MongoDB)
# ===========================================
# Local:  mongodb://localhost:27017/global_fit_ulttra
# Atlas:  mongodb+srv://username:password@cluster.mongodb.net/global_fit_ulttra?retryWrites=true&w=majority
# Note: URL-encode special chars in credentials (e.g. '@' -> '%40', '#' -> '%23')
# IMPORTANT: App exits immediately if MongoDB connection fails.
MONGODB_URI=mongodb://localhost:27017/global_fit_ulttra
MONGODB_POOL_SIZE=10

# ===========================================
# [OPTIONAL] Redis (Falls back to in-memory if not available)
# ===========================================
# Local Docker: redis://localhost:6379  (start: docker-compose up redis)
# Redis Cloud:  rediss://username:password@host:port
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=300

# ===========================================
# [OPTIONAL] External Financial API Keys
# ===========================================
# App runs without these; only the associated data endpoints will be unavailable.

# Alpha Vantage - Stock quotes (free demo key has strict rate limits)
# Get key at: https://www.alphavantage.co/support/#api-key/
ALPHA_VANTAGE_API_KEY=demo

# CoinGecko - Crypto prices (free tier works without key)
COINGECKO_API_KEY=

# NewsAPI - Financial news
# Get key at: https://newsapi.org/register
NEWS_API_KEY=

# FRED - Economic indicators (St. Louis Federal Reserve)
# Get key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub - Market news & real-time data
# Get key at: https://finnhub.io/register
FINNHUB_API_KEY=

# ===========================================
# [REQUIRED] Security Configuration
# ===========================================
# CORS: Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Global API rate limiting (applied to all /api/** routes)
# Window: 900000ms = 15 minutes, Max: 100 requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Additional rate limiting tiers (configured in code):
#   Auth: 5 req/15min | Authenticated users: 1000/15min | Admin: 20/15min
#   AI endpoints: 10 req/1min | Health checks: 1000 req/1min

# JWT Authentication
# IMPORTANT: Change JWT_SECRET to a strong random value in production!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=global-fit-ulttra-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# [OPTIONAL] Circuit Breaker Configuration
# ===========================================
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# ===========================================
# [OPTIONAL] Logging
# ===========================================
# Levels: error, warn, info, http, debug
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ===========================================
# [OPTIONAL] Socket.io CORS
# ===========================================
SOCKET_IO_CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ===========================================
# [OPTIONAL] Feature Flags
# ===========================================
ENABLE_CACHE_WARMING=false
ENABLE_METRICS_COLLECTION=true

# ===========================================
# [OPTIONAL] Keep-Alive Self-Ping
# ===========================================
# Prevents server sleep on free Render tier. Set false for local or paid plans.
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_URL=https://backend-global-fit-ulttra.onrender.com/api/v1/health/ping
KEEP_ALIVE_INTERVAL_MS=600000

# ===========================================
# [OPTIONAL] Message Queue (RabbitMQ)
# ===========================================
# Server starts without this; AI async job queue is disabled if unavailable.
# Local Docker: amqp://localhost:5672    (start: docker-compose up rabbitmq)
# CloudAMQP:    amqps://username:password@host/vhost
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=global_fit_ulttra

# ===========================================
# [CONDITIONAL] Groq AI Configuration
# ===========================================
# Leave empty to run without AI features (core financial data still works).
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ===========================================
# [CONDITIONAL] Agentic Hybrid Financial RAG
# ===========================================

# --- Qdrant Vector Database ---
# Local Docker: http://localhost:6333   (start: docker-compose up qdrant)
# Qdrant Cloud: https://your-cluster.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# IMPORTANT: This collection name must match across all environments.
QDRANT_COLLECTION=global_fit_ulttra_financial_documents
QDRANT_ENABLED=true

# --- Embedding Engine ---
# 'local'       - Free, no API key (uses @xenova/transformers)
# 'openai'      - Requires EMBEDDING_API_KEY (OpenAI key)
# 'huggingface' - Requires EMBEDDING_API_KEY (HuggingFace token)
# 'voyage'      - Requires EMBEDDING_API_KEY (Voyage AI key)
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- Optional Cohere Cross-Encoder Reranker (local fallback if empty) ---
COHERE_API_KEY=

# --- Hybrid Retrieval & Reciprocal Rank Fusion (RRF) Parameters ---
RAG_SEMANTIC_CACHE_ENABLED=true
RAG_SIMILARITY_THRESHOLD=0.65
RAG_RRF_DENSE_WEIGHT=0.65
RAG_RRF_SPARSE_WEIGHT=0.35
RAG_RRF_K=60
RAG_CONFIDENCE_THRESHOLD=0.40
RAG_MAX_AGENT_ITERATIONS=3

# ===========================================
# [CONDITIONAL] LiteLLM AI Gateway (Optional)
# ===========================================
# Free, self-hosted OpenAI-compatible AI proxy (runs in Docker).
# Start: docker-compose up litellm
# NOTE: docker-compose.yml also reads LITELLM_MASTER_KEY and LITELLM_SALT_KEY
#       from the ROOT .env file (not this file) to secure the gateway admin.
LITELLM_ENABLED=false
LITELLM_URL=http://localhost:8000/v1
LITELLM_API_KEY=

# ===========================================
# [CONDITIONAL] LangSmith Tracing (Optional)
# ===========================================
# Leave disabled for zero cost and fully offline evaluation.
# Get key at: https://smith.langchain.com
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=global-fit-ulttra-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===========================================
# Legacy aliases (auto-mapped in environment.js — do not remove)
# ===========================================
# Use canonical names above for new configuration. These aliases remain
# supported for backward compatibility and are automatically mapped:
#   LOCAL_EMBEDDING_MODEL -> EMBEDDING_MODEL
#   HUGGINGFACE_API_KEY   -> EMBEDDING_API_KEY
#   RAG_DENSE_WEIGHT      -> RAG_RRF_DENSE_WEIGHT
#   RAG_SPARSE_WEIGHT     -> RAG_RRF_SPARSE_WEIGHT
#   RAG_MAX_ITERATIONS    -> RAG_MAX_AGENT_ITERATIONS
#   LITELLM_BASE_URL      -> LITELLM_URL
#   LANGCHAIN_API_KEY     -> LANGSMITH_API_KEY
#   LANGCHAIN_PROJECT     -> LANGSMITH_PROJECT
#   LANGCHAIN_TRACING_V2  -> LANGSMITH_ENABLED
