{
  "name": "globalfi-ultra",
  "version": "1.0.0",
  "description": "High-performance financial orchestration engine",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0",
    "vscode": "^1.22.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:integration": "node test-integration.js",
    "test:endpoints": "bash test-all-endpoints.sh",
    "test:endpoints:win": "powershell -ExecutionPolicy Bypass -File test-all-endpoints.ps1",
    "ai:demo": "node examples/test-ai-features.js",
    "ai:integrate": "node examples/integrate-ai.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "redis:monitor": "node src/tools/redisMonitor.js --interactive",
    "redis:keys": "node src/tools/redisMonitor.js --list-keys",
    "redis:watch": "node src/tools/redisMonitor.js --watch",
    "redis:stats": "node src/tools/redisMonitor.js --stats",
    "redis:export": "node src/tools/redisMonitor.js --export ./cache-export.json",
    "redis:health": "node src/tools/redisMonitor.js --health"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "axios": "^1.6.7",
    "axios-retry": "^4.0.0",
    "bcrypt": "^5.1.1",
    "big.js": "^6.2.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "groq-sdk": "^0.37.0",
    "helmet": "^7.1.0",
    "inquirer": "^13.2.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "ora": "^9.3.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "globals": "^17.3.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.1.3"
  },
  "keywords": [
    "fintech",
    "financial-data",
    "orchestration",
    "real-time",
    "socket.io"
  ],
  "author": "Vishal Sanam",
  "license": "MIT"
}
